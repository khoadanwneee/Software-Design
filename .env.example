# Shared
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
API_PORT=4000
JWT_SECRET=change-me-in-local-dev
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=10

# Database
DATABASE_URL=postgresql://unihub:unihub@localhost:5432/unihub_workshop?schema=public

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379

# Web
VITE_API_BASE_URL=http://localhost:4000/api
VITE_APP_NAME=UniHub Workshop

# Local object storage scaffold
UPLOAD_DIR=./tmp/uploads
MAX_UPLOAD_BYTES=10485760

# AI Summary
AI_PROVIDER=ngrok
NGROK_AI_SUMMARY_URL=https://your-ngrok-domain.ngrok-free.app/summarize
NGROK_AI_SUMMARY_API_KEY=
NGROK_AI_SUMMARY_MODEL=ngrok-ai-summary

# Optional legacy Gemini provider (only used with AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AI_SUMMARY_PDF_MAX_MB=10
AI_SUMMARY_TIMEOUT_MS=30000
AI_SUMMARY_MAX_INPUT_CHARS=30000
AI_SUMMARY_MAX_OUTPUT_WORDS=250

# Rate limiting thresholds
RATE_LIMIT_DEFAULT_POINTS=120
RATE_LIMIT_DEFAULT_DURATION_SECONDS=60
RATE_LIMIT_REGISTRATION_POINTS=10
RATE_LIMIT_PAYMENT_POINTS=8
RATE_LIMIT_CHECKIN_SYNC_POINTS=30

# VNPay (sandbox)
VNP_TMNCODE=your_tmn_code
VNP_HASHSECRET=your_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_IPN_URL=https://your-public-domain/api/payments/vnpay/ipn
VNP_RETURN_URL=http://localhost:4000/api/payments/vnpay/return

# Nightly student CSV import (one-way integration from legacy system)
# Leave STUDENT_IMPORT_WATCH_DIR empty to disable periodic scan.
STUDENT_IMPORT_WATCH_DIR=
STUDENT_IMPORT_SCAN_INTERVAL_SECONDS=300

# SMTP (notification emails)
# Leave SMTP_HOST empty to use the mock email provider in the worker.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UniHub <no-reply@unihub.local>
